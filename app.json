{
  "expo": {
    "name": "Halı Yıkama Otomasyonu",
    "slug": "haliyikamaotomasyon",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haliyikamaotomasyon.app"
    },
    "android": {
      "package": "com.haliyikamaotomasyon.app"
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Müşteri eklemek için telefon rehberinize erişim izni gerekiyor."
        }
      ]
    ]
  }
}
